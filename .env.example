# Copier ce fichier en .env et remplacer les valeurs "change-me" (jamais versionné).
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
READONLY_PASSWORD=change-me

# Envoi des fiches à l'API Sentinel (bloc 4). Laisser vide pour désactiver l'envoi.
# Sur Mac, l'API du bloc 4 lancée avec Docker est joignable à cette adresse :
SENTINEL_API_URL=http://host.docker.internal:8000
SENTINEL_API_KEY=change-me

# Démo : un serveur de jeu simulé dépose un fichier à chaque exécution.
SIMULATION=true
